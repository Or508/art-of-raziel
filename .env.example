# Database (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=password
DB_NAME=art_of_raziel
# Set to true for hosted MySQL that requires TLS
DB_SSL=false

# API
PORT=5000
JWT_SECRET=replace_with_a_long_random_string
# Extra browser origins, comma-separated. The site's own address is always allowed.
CLIENT_URL=http://localhost:5173

# Admin account (npm run create-admin --prefix server) and new-order emails
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Gmail used to send emails. Mail is skipped when these are empty.
EMAIL_USER=
EMAIL_PASS=

# Optional: Google Sheets copy of contact requests
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
